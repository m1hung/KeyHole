node_modules/
dist/
*.log
.DS_Store

# Desktop build inputs, both generated by desktop/scripts/stage.mjs from the app
# build and the brand icons. Committing them would put a third copy of the
# renderer and a duplicate of the icon under version control.
desktop/renderer/
desktop/build/

# Tray-app build inputs, generated by server-tray/scripts/bundle.mjs from the
# server source and the brand icons.
server-tray/server-dist/
server-tray/build/

# The sync server's live database. Holds account verifiers and stored envelopes
# — runtime state, and the last thing that should ever reach a public repo.
server/data/

# Never commit a real vault. The only checked-in vault is examples/demo-vault.keyhole.json,
# which contains fabricated data and a published master password.
*.keyhole.json
!examples/demo-vault.keyhole.json
