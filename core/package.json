{
  "name": "@keyhole/core",
  "version": "1.0.0",
  "type": "module",
  "description": "Framework-agnostic crypto + vault core for Keyhole",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "demo": "node --experimental-strip-types harness/demo.ts",
    "typecheck": "tsc --noEmit",
    "demo:vault": "node --experimental-strip-types harness/make-demo-vault.ts",
    "pack:vectors": "node --experimental-strip-types harness/pack-vectors.ts"
  },
  "dependencies": {
    "hash-wasm": "4.12.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@noble/hashes": "^2.2.0",
    "@types/node": "^24.10.1",
    "vitest": "4.1.10"
  }
}
