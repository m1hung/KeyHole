{
  "name": "@keyhole/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Keyhole self-hosted sync server — stores encrypted envelopes, reads none of them",
  "scripts": {
    "start": "node --experimental-strip-types src/index.ts",
    "dev": "node --experimental-strip-types --watch src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.integration.json"
  },
  "engines": {
    "node": ">=22.5"
  },
  "dependencies": {
    "fastify": "5.10.0"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "vitest": "4.1.10"
  }
}
