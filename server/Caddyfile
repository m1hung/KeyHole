# TLS termination for the Keyhole sync server.
#
# Used by the "tls" profile in docker-compose.yml:
#   KEYHOLE_DOMAIN=sync.example.com docker compose -f server/docker-compose.yml --profile tls up -d
#
# Why this exists: the vault payload is encrypted end-to-end, but the sync
# credential travels in an Authorization header, so plain HTTP over a network
# hands it to anyone listening. Browsers enforce the same thing from the other
# side — Chromium only treats loopback as a trustworthy origin, so the app and
# extension refuse plain http:// to any other host. Without TLS a remote client
# cannot connect at all.

{$KEYHOLE_DOMAIN} {
	encode zstd gzip

	# The sync server is not published on the host; Caddy reaches it over the
	# compose network. Health checks keep Caddy from serving a dead upstream.
	reverse_proxy keyhole-sync:8787 {
		health_uri /api/v1/health
		health_interval 30s
	}
}

# LAN-only, no public domain? Caddy cannot get a public certificate for a name
# it does not control. Replace the block above with an internal one:
#
#   keyhole.local {
#   	tls internal
#   	reverse_proxy keyhole-sync:8787
#   }
#
# That issues a certificate from Caddy's own CA, which every client device must
# then trust (export it from /data/caddy/pki/authorities/local/root.crt and
# install it as a trusted root) and which every client must be able to resolve
# to this host. Trusting a private CA is a real decision — a public domain with
# a real certificate is the less surprising path if you have one.
